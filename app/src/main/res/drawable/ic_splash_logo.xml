<?xml version="1.0" encoding="utf-8"?>
<!-- Logo para la pantalla de inicio (splash): círculo con el gradiente de marca
     + la casa blanca, igual que el logo del login. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Círculo con gradiente primary -> secondary -->
    <path android:pathData="M54,54m-54,0a54,54 0 1,0 108,0a54,54 0 1,0 -108,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="54"
                android:endX="108"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3A5A90" />
                <item android:offset="1.0" android:color="#FF4A6EA8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Casa blanca centrada -->
    <group
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="27.6"
        android:translateY="28.7">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M10,20v-6h4v6h5v-8h3L12,3 2,12h3v8z" />
    </group>
</vector>
